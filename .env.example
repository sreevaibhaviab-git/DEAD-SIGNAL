# DEAD SIGNAL - EVA conversation backend settings.
# Copy this file to .env and fill in your own values. Never commit .env.
# The game is fully playable with no .env at all: scripted EVA dialogue still works,
# only the live conversation (V to talk / T to type) is disabled.

# --- Claude API (EVA's dialogue) ---
# Create a key at https://platform.claude.com/ (Settings > API keys)
ANTHROPIC_API_KEY=
# Fast, low-cost model recommended for live dialogue
EVA_MODEL=claude-haiku-5-5
# low | medium | high  (low = fastest replies)
EVA_EFFORT=low

# --- Optional: ElevenLabs voice for EVA ---
# Leave blank to use the browser's built-in speech voice instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Usage controls ---
# Replies allowed per game session (a session resets when the page reloads)
EVA_MAX_TURNS_PER_SESSION=40
# Requests allowed per minute (all sessions combined)
EVA_MAX_REQUESTS_PER_MINUTE=8
# Replies allowed per day (all sessions combined; resets when the server restarts or at midnight)
EVA_DAILY_LIMIT=200
# Longest player message accepted (characters)
EVA_MAX_INPUT_CHARS=300

# --- Server ---
PORT=5173
